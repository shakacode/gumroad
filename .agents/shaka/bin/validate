#!/bin/sh
# Generated by shaka seam init.
set -eu
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"
if [ "$#" -gt 1 ]; then
  echo "Usage: .agents/shaka/bin/validate [base-ref]" >&2
  exit 2
fi
base_ref=${1:-main}
base_remote=origin
base_branch=$base_ref
if [ "${base_ref#*/}" != "$base_ref" ]; then
  candidate_remote=${base_ref%%/*}
  if git remote get-url "$candidate_remote" >/dev/null 2>&1; then
    base_remote=$candidate_remote
    base_branch=${base_ref#*/}
  fi
fi
if ! git check-ref-format "refs/heads/$base_branch" >/dev/null 2>&1; then
  echo "Invalid base ref: $base_ref" >&2
  exit 2
fi
if ! git remote get-url "$base_remote" >/dev/null 2>&1; then
  echo "Remote '$base_remote' is not configured." >&2
  exit 1
fi
if ! git fetch --no-tags --quiet "$base_remote" "+refs/heads/$base_branch:refs/remotes/$base_remote/$base_branch"; then
  echo "Could not refresh $base_remote/$base_branch; check the remote and branch." >&2
  exit 1
fi
ruby -c bin/setup >/dev/null
sh -n .agents/shaka/bin/test
if [ ! -x node_modules/.bin/eslint ]; then
  echo "JavaScript dependencies are missing; run .agents/shaka/bin/setup first." >&2
  exit 1
fi
if ! bundle check >/dev/null 2>&1; then
  echo "Ruby dependencies are missing; run .agents/shaka/bin/setup first." >&2
  exit 1
fi
npm run lint-fast
RAILS_ENV=test bundle exec rails js:export
npm run typecheck
bundle exec rubocop --format github
ruby bin/check-migration-versions "$base_remote/$base_branch" HEAD
ruby spec/bin/check_migration_versions_test.rb
ruby spec/bin/branch_specs_test.rb
bash script/test-reuse-full-suite
