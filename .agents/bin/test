#!/bin/sh
# Generated by shaka seam init.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
if ! bundle check >/dev/null 2>&1; then
  echo "Ruby dependencies are missing; run .agents/bin/setup first." >&2
  exit 1
fi
if [ "$#" -gt 0 ]; then
  exec bin/rspec "$@"
fi
if [ ! -x node_modules/.bin/vitest ]; then
  echo "JavaScript dependencies are missing; run .agents/bin/setup first." >&2
  exit 1
fi
LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npm test
RAILS_ENV=test bundle exec rails test
exec bin/rspec
