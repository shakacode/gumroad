#!/bin/sh
set -eu

export RAILS_ENV=benchmark
export RACK_ENV=benchmark
export NODE_ENV=production
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"
export VITE_RUBY_MODE=production
export VITE_RUBY_ASSET_HOST="${VITE_RUBY_ASSET_HOST:-http://${BENCHMARK_HOST:-gumroad.localhost}:${DEV_LANE_PORT:-3000}}"
export VITE_RUBY_AUTO_BUILD=false
export DISABLE_SPRING=1

if node -e 'process.exit(require("./package.json").scripts["build:public-rsc"] ? 0 : 1)'; then
  STRONGBOX_GENERAL="$(ruby -ropenssl -e 'print OpenSSL::PKey::RSA.generate(2048).to_pem')"
  export STRONGBOX_GENERAL
  export STRONGBOX_GENERAL_PASSWORD=""
  npm run build:public-rsc
fi
