#!/bin/sh
set -eu

export RAILS_ENV=benchmark
export RACK_ENV=benchmark
export NODE_ENV=production

if ! node -e 'process.exit(require("./package.json").scripts["build:public-rsc"] ? 0 : 1)'; then
  echo "Skipping renderer: this checkout does not build public RSC."
  exec tail -f /dev/null
fi

node_pids="$(pidof node 2>/dev/null || true)"
if [ -n "${node_pids}" ]; then
  for node_pid in ${node_pids}; do
    kill "${node_pid}"
  done
fi

exec node client/node-renderer.cjs
