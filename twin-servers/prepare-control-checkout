#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
control_ref=${SHAKAPERF_CONTROL_REF:-827a920737870be653e70826d2be9e654a6065ef}
control_dir=${SHAKAPERF_CONTROL_DIR:-"$repo_root/.shakaperf-control"}
expected_revision=$(git -C "$repo_root" rev-parse "$control_ref^{commit}")

if [ -e "$control_dir/.git" ]; then
  actual_revision=$(git -C "$control_dir" rev-parse HEAD)
  if [ "$actual_revision" != "$expected_revision" ]; then
    echo "Control checkout is $actual_revision; expected $expected_revision" >&2
    exit 1
  fi
  echo "Control checkout already pinned to $actual_revision at $control_dir"
  exit 0
fi

if [ -e "$control_dir" ]; then
  echo "Refusing to overwrite existing non-worktree path: $control_dir" >&2
  exit 1
fi

git -C "$repo_root" worktree add --detach "$control_dir" "$expected_revision"
echo "Prepared pre-RSC control $expected_revision at $control_dir"
