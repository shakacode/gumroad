#!/usr/bin/env bash
set -euo pipefail

APP_NAME="gumroad-rorp"
DEFAULT_ORG="shakacode-open-source-examples-staging"

usage() {
  cat <<'USAGE'
Usage: bin/prepare-control-plane-benchmark-secrets [--org CPLN_ORG]

Creates surface-owned MySQL, Mongo, and R2 dictionary secrets if they do not
already exist. R2 creation reads S3_ENDPOINT, AWS_ACCESS_KEY_ID,
AWS_SECRET_ACCESS_KEY, and S3_BUCKET from the environment. Existing secrets are
validated and never rotated. cpflow owns the application secret lifecycle.
USAGE
}

org="${CPLN_ORG:-$DEFAULT_ORG}"
if [ "$#" -gt 0 ]; then
  if [ "$#" -ne 2 ] || [ "$1" != "--org" ]; then
    usage >&2
    exit 1
  fi
  org="$2"
fi

command -v cpln >/dev/null || { echo "cpln is required." >&2; exit 1; }
command -v openssl >/dev/null || { echo "openssl is required." >&2; exit 1; }

if ! cpln org get "$org" >/dev/null 2>&1; then
  echo "cpln must have authenticated access to ${org} through its profile or CPLN_TOKEN." >&2
  exit 1
fi

random_secret() {
  openssl rand -hex 64
}

secret_exists() {
  cpln secret get "$1" --org "$org" >/dev/null 2>&1
}

validate_dictionary() {
  local secret_name="$1"
  shift
  local secret_payload

  if ! secret_payload="$(cpln secret reveal "$secret_name" --org "$org" --output json 2>/dev/null)"; then
    echo "Secret ${secret_name} exists but cannot be revealed for validation." >&2
    exit 1
  fi

  SECRET_PAYLOAD="$secret_payload" ruby -rjson -e '
    payload = JSON.parse(ENV.fetch("SECRET_PAYLOAD"))
    data = payload.fetch("data", {})
    missing = ARGV.reject { |key| data[key].is_a?(String) && !data[key].empty? }
    abort "missing required entries: #{missing.join(", ")}" if missing.any?
    abort "contains a public placeholder value" if data.values.any? { |value| value.to_s.match?(/replace-with-real|the_password/) }
  ' "$@" || {
    echo "Secret ${secret_name} is not ready. Repair it explicitly; this script will not rotate an existing secret." >&2
    exit 1
  }
}

create_mysql_secret() {
  local secret_name="${APP_NAME}-mysql"
  if secret_exists "$secret_name"; then
    validate_dictionary "$secret_name" database username password root_password
    echo "Secret ${secret_name} already exists; leaving database credentials unchanged."
    return
  fi

  cpln secret create-dictionary \
    --org "$org" \
    --name "$secret_name" \
    --entry database=gumroad_benchmark \
    --entry username=gumroad \
    --entry "password=$(random_secret)" \
    --entry "root_password=$(random_secret)"
}

create_mongo_secret() {
  local secret_name="${APP_NAME}-mongo"
  if secret_exists "$secret_name"; then
    validate_dictionary "$secret_name" username password
    echo "Secret ${secret_name} already exists; leaving database credentials unchanged."
    return
  fi

  cpln secret create-dictionary \
    --org "$org" \
    --name "$secret_name" \
    --entry username=gumroad \
    --entry "password=$(random_secret)"
}

create_r2_secret() {
  local secret_name="${APP_NAME}-r2"
  local secret_payload

  if secret_exists "$secret_name"; then
    validate_dictionary "$secret_name" endpoint access_key_id secret_access_key bucket
    secret_payload="$(cpln secret reveal "$secret_name" --org "$org" --output json 2>/dev/null)"
    EXPECTED_R2_BUCKET="${S3_BUCKET:-}" SECRET_PAYLOAD="$secret_payload" ruby -rjson -ruri -e '
      data = JSON.parse(ENV.fetch("SECRET_PAYLOAD")).fetch("data")
      endpoint = URI.parse(data.fetch("endpoint"))
      valid_endpoint = endpoint.scheme == "https" && endpoint.host&.end_with?(".r2.cloudflarestorage.com")
      expected_bucket = ENV.fetch("EXPECTED_R2_BUCKET")
      valid_bucket = expected_bucket.empty? || data.fetch("bucket") == expected_bucket
      abort "unexpected R2 endpoint or bucket" unless valid_endpoint && valid_bucket
    ' || {
      echo "Secret ${secret_name} is not ready. Repair it explicitly; this script will not rotate an existing secret." >&2
      exit 1
    }
    echo "Secret ${secret_name} already exists; leaving storage credentials unchanged."
    return
  fi

  if [ -z "${S3_ENDPOINT:-}" ] || [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ] || [ -z "${S3_BUCKET:-}" ]; then
    echo "S3_ENDPOINT, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and S3_BUCKET are required to create ${secret_name}." >&2
    exit 1
  fi

  R2_ENDPOINT="$S3_ENDPOINT" ruby -ruri -e '
    endpoint = URI.parse(ENV.fetch("R2_ENDPOINT"))
    abort "S3_ENDPOINT must be an HTTPS Cloudflare R2 endpoint" unless endpoint.scheme == "https" && endpoint.host&.end_with?(".r2.cloudflarestorage.com")
  '

  cpln secret create-dictionary \
    --org "$org" \
    --name "$secret_name" \
    --entry "endpoint=${S3_ENDPOINT}" \
    --entry "access_key_id=${AWS_ACCESS_KEY_ID}" \
    --entry "secret_access_key=${AWS_SECRET_ACCESS_KEY}" \
    --entry "bucket=${S3_BUCKET}" \
    >/dev/null
}

create_mysql_secret
create_mongo_secret
create_r2_secret
